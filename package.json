{
  "name": "quantumq-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:core && vite build",
    "preview": "vite preview",
    "check": "tsc -p packages/core/tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "cargo tauri",
    "test:e2e": "npm run build && playwright test",
    "build:core": "npm run build --workspace @quantumq/core"
  },
  "dependencies": {
    "@quantumq/core": "2.0.0",
    "@tauri-apps/api": "2.9.0",
    "@tauri-apps/plugin-store": "~2.3.0",
    "fflate": "0.8.3",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.0.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
