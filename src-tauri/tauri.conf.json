{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuantumQ",
  "version": "2.0.0",
  "identifier": "com.ph.quantumq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuantumQ",
        "width": 1024,
        "height": 650,
        "minWidth": 360,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "PuzzleGame",
    "shortDescription": "Quantum circuit puzzle game",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE.txt",
    "android": {
      "minSdkVersion": 24,
      "versionCode": 6
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
